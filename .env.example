# Environment Configuration Template
# Copy this file to .env and fill in your actual values

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Application ports
# Backend API server port
PORT=3010
# Frontend Next.js server port (configured in frontend/.env)
FRONTEND_PORT=3000

# Application URLs
# Backend API base URL (used by frontend to make API calls)
NEXT_PUBLIC_API_URL=http://localhost:3010
# Frontend application URL (used for CORS and redirects)
FRONTEND_URL=http://localhost:3000

#==============================================================================
# AUTH0 CONFIGURATION
#==============================================================================

# Backend JWT Verification
# Auth0 issuer URL for JWT token verification
# Format: https://<your-tenant>.<region>.auth0.com/
# Example: https://velvetkey-dev.us.auth0.com/
# IMPORTANT: Must include trailing slash
AUTH0_ISSUER=https://your-tenant.region.auth0.com/

# Auth0 audience (API identifier from Auth0 dashboard)
# This should match the identifier you set for your API in Auth0
AUTH0_AUDIENCE=https://api.velvetkey.com

# Frontend Auth0 Configuration
# Auth0 domain (without https:// or trailing slash)
# Example: velvetkey-dev.us.auth0.com
AUTH0_DOMAIN=your-tenant.region.auth0.com

# Auth0 application client ID (from Auth0 dashboard)
AUTH0_CLIENT_ID=your_auth0_client_id

# Auth0 application client secret (from Auth0 dashboard)
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Auth0 session secret for encrypting cookies
# MUST be at least 32 characters long
# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH0_SECRET=generate_a_secure_random_string_at_least_32_characters_long

# Auth0 base URL (where your app is hosted)
AUTH0_BASE_URL=http://localhost:3000

# Auth0 callback URLs (must be configured in Auth0 dashboard)
# Add these to your Auth0 application settings:
# - Allowed Callback URLs: http://localhost:3000/api/auth/callback
# - Allowed Logout URLs: http://localhost:3000
# - Allowed Web Origins: http://localhost:3000

#==============================================================================
# STRIPE CONFIGURATION
#==============================================================================

# Stripe secret key (from Stripe dashboard)
# Use test key (sk_test_...) for development
# Use live key (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe webhook signing secret (from Stripe webhook settings)
# Used to verify webhook signatures
# Get this after creating a webhook endpoint in Stripe dashboard
# Webhook URL should be: https://your-domain.com/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Connect configuration
# Client ID for Stripe Connect (from Stripe Connect settings)
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id

# Stripe Connect redirect URLs (must match Stripe Connect settings)
# Return URL after successful Connect onboarding
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/host/stripe/return
# Refresh URL if user needs to complete onboarding
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/host/stripe/refresh

#==============================================================================
# DATABASE CONFIGURATION
#==============================================================================

# Database type (sqlite for development, postgres for production)
DB_TYPE=sqlite

# SQLite configuration (for local development)
# Path to SQLite database file
DB_DATABASE=./velvetkey.db

# PostgreSQL configuration (for production)
# Uncomment and configure these when using PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=velvetkey
# DB_PASSWORD=your_secure_password
# DB_DATABASE=velvetkey
# DB_SSL=false

# Database synchronization (set to false in production)
# When true, TypeORM will auto-create/update tables based on entities
DB_SYNCHRONIZE=true

# Database logging (set to false in production for performance)
DB_LOGGING=true

#==============================================================================
# CORS CONFIGURATION
#==============================================================================

# Allowed origins for CORS (comma-separated list)
# In development, this should include your frontend URL
# In production, add your production frontend domain
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Allow credentials (cookies, authorization headers) in CORS requests
CORS_CREDENTIALS=true

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Log level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

#==============================================================================
# SECURITY SETTINGS
#==============================================================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# JWT token expiration (in seconds)
JWT_EXPIRATION=3600

#==============================================================================
# FEATURE FLAGS
#==============================================================================

# Enable/disable features for testing
ENABLE_STRIPE_CONNECT=true
ENABLE_INVITE_CODES=true
ENABLE_CHECKIN_SYSTEM=true

#==============================================================================
# DEVELOPMENT TOOLS
#==============================================================================

# Enable Swagger API documentation (disable in production)
ENABLE_SWAGGER=true

# Swagger path (where API docs are served)
SWAGGER_PATH=api/docs

#==============================================================================
# PRODUCTION NOTES
#==============================================================================

# Before deploying to production:
# 1. Set NODE_ENV=production
# 2. Use production Auth0 tenant and credentials
# 3. Use Stripe live keys (sk_live_...)
# 4. Switch to PostgreSQL database
# 5. Set DB_SYNCHRONIZE=false
# 6. Set DB_LOGGING=false
# 7. Generate new AUTH0_SECRET (32+ characters)
# 8. Update CORS_ORIGINS with production domain
# 9. Set LOG_LEVEL=warn or error
# 10. Disable ENABLE_SWAGGER=false
# 11. Configure proper rate limiting
# 12. Set up SSL/TLS certificates
# 13. Configure webhook URLs with production domain
# 14. Update Auth0 callback URLs with production domain

#==============================================================================
# DOCKER COMPOSE NOTES
#==============================================================================

# When using Docker Compose:
# - Backend service is accessible at http://localhost:3010
# - Frontend service is accessible at http://localhost:3000
# - Services communicate via Docker network using service names
# - NEXT_PUBLIC_API_URL should be http://localhost:3010 (browser-side)
# - Internal service calls can use http://backend:3010

#==============================================================================
# TROUBLESHOOTING
#==============================================================================

# Common issues:
# 1. "Invalid issuer" error: Check AUTH0_ISSUER has trailing slash
# 2. CORS errors: Verify CORS_ORIGINS includes frontend URL
# 3. Auth0 login fails: Check callback URLs in Auth0 dashboard
# 4. Stripe webhook fails: Verify STRIPE_WEBHOOK_SECRET is correct
# 5. Database connection fails: Check DB_* configuration
# 6. Port conflicts: Ensure ports 3000 and 3010 are available