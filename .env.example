# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
NODE_ENV=development
# Options: development, production, test

# =============================================================================
# BACKEND CONFIGURATION (NestJS)
# =============================================================================

# Server Configuration
BACKEND_PORT=3010
BACKEND_HOST=0.0.0.0

# Database Configuration
# For development: SQLite file-based
# For production: PostgreSQL connection string
DATABASE_URL=file:./dev.db
# Production example: postgresql://user:password@localhost:5432/velvetkey

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
# Production example: https://app.velvetkey.com,https://api.velvetkey.com

# Logging
LOG_LEVEL=debug
# Options: error, warn, info, debug, verbose

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =============================================================================
# FRONTEND CONFIGURATION (Next.js)
# =============================================================================

# Server Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3010
# Production example: https://api.velvetkey.com

# =============================================================================
# AUTH0 CONFIGURATION
# =============================================================================

# Auth0 Domain and Client Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_CLIENT_SECRET=your_client_secret_here

# Auth0 Audience (API Identifier)
AUTH0_AUDIENCE=https://velvetkey-api

# Auth0 Secret for Session Management
# Generate with: openssl rand -base64 32
AUTH0_SECRET=your_32_character_or_longer_secret_here_replace_this

# Auth0 Base URL (where your app is hosted)
AUTH0_BASE_URL=http://localhost:3000
# Production example: https://app.velvetkey.com

# Auth0 Issuer URL (for JWT validation)
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/

# Auth0 Token Signing Algorithm
AUTH0_TOKEN_SIGNING_ALG=RS256

# =============================================================================
# STRIPE CONFIGURATION
# =============================================================================

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Connect Configuration
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id_here

# Stripe Webhook Secret (for signature verification)
# Get this from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Connect Return URLs
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/host/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/host/stripe/refresh
# Production examples:
# STRIPE_CONNECT_RETURN_URL=https://app.velvetkey.com/host/stripe/return
# STRIPE_CONNECT_REFRESH_URL=https://app.velvetkey.com/host/stripe/refresh

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_EXPIRATION=3600
# Time in seconds (3600 = 1 hour)

# Session Configuration
SESSION_SECRET=your_session_secret_here_min_32_chars
# Generate with: openssl rand -base64 32

# Cookie Security
COOKIE_SECURE=false
# Set to true in production (requires HTTPS)
COOKIE_SAME_SITE=lax
# Options: strict, lax, none

# =============================================================================
# EMAIL CONFIGURATION (Optional - for future notifications)
# =============================================================================

# SMTP Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@velvetkey.com

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================

# Sentry Configuration (Error Tracking)
# SENTRY_DSN=https://your_sentry_dsn_here
# SENTRY_ENVIRONMENT=development

# Application Insights / DataDog / New Relic
# APM_SERVICE_NAME=velvetkey
# APM_API_KEY=your_apm_api_key_here

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/Disable Features
ENABLE_REGISTRATION=true
ENABLE_STRIPE_CONNECT=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Compose Service Names
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=velvetkey
POSTGRES_PASSWORD=velvetkey_dev_password
POSTGRES_DB=velvetkey

# Redis Configuration (if using for caching/sessions)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable Debug Mode
DEBUG=false

# Enable API Documentation (Swagger)
ENABLE_SWAGGER=true

# Enable GraphQL Playground
ENABLE_GRAPHQL_PLAYGROUND=true

# Hot Reload
WATCH_MODE=true

# =============================================================================
# PRODUCTION OPTIMIZATIONS
# =============================================================================

# Compression
ENABLE_COMPRESSION=true

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Max Request Body Size
MAX_REQUEST_SIZE=10mb

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. NEVER commit the actual .env file to version control
# 2. Generate secure random values for all secrets:
#    - AUTH0_SECRET: openssl rand -base64 32
#    - SESSION_SECRET: openssl rand -base64 32
# 3. In production, use environment-specific values:
#    - Set COOKIE_SECURE=true
#    - Use HTTPS URLs for all BASE_URL and RETURN_URL values
#    - Use production Stripe keys (sk_live_*, pk_live_*)
#    - Set NODE_ENV=production
# 4. For Docker deployments, these values can be overridden in:
#    - docker-compose.yml (development)
#    - docker-compose.prod.yml (production)
#    - Kubernetes secrets/configmaps
#    - Cloud provider secret managers (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Validate all required environment variables on application startup
# 6. Use different Auth0 tenants for development and production
# 7. Rotate secrets regularly in production environments
#
# =============================================================================