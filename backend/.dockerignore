# Backend Docker ignore rules
# Excludes files from Docker build context to optimize build times and image size

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
*.test.ts
*.spec.ts
test/
.nyc_output/

# Development files
.env
.env.local
.env.development
.env.test
*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Build artifacts (keep dist/ as it may be needed for production)
*.log
*.pid
*.seed
*.pid.lock

# Database files (development only)
*.sqlite
*.db
database.sqlite

# TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# ESLint
.eslintcache

# Prettier
.prettierignore

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Misc
.cache/
tmp/
temp/
*.tmp