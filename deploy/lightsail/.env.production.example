# Copy to repo root as `.env` on the Lightsail host (never commit secrets).

DOMAIN=epicsexual.com
ACME_EMAIL=you@example.com
CONTACT_EMAIL=admin@epicsexual.com

# openssl rand -base64 32
AUTH_SECRET=

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Free gatherings at launch; enable when Connect is ready
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=epicsexual <hello@epicsexual.com>

# Private S3 bucket (avatars + check-in photos). Omit to store avatars on backend volume.
S3_PHOTO_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
