# Root .dockerignore - Exclude unnecessary files from Docker build context

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# IDE and Editor
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
.cursor

# Documentation
*.md
!README.md
docs
LICENSE

# Environment files (should be mounted or passed at runtime)
.env
.env.*
!.env.example

# Node modules (will be installed in container)
node_modules
npm-debug.log
yarn-error.log
yarn-debug.log
.pnpm-debug.log

# Build artifacts (will be built in container)
dist
build
.next
out
coverage
.turbo

# Test files
test
tests
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__
__mocks__
jest.config.js
jest.config.ts

# Development tools
.eslintrc*
.prettierrc*
.editorconfig
tsconfig.json
tsconfig.*.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Temporary files
tmp
temp
*.tmp
*.temp

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Docker files (avoid recursive Docker builds)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts (unless needed for container startup)
scripts

# Database files (should be in volumes)
*.db
*.sqlite
*.sqlite3
data

# Cache directories
.cache
.parcel-cache
.npm
.yarn
.pnp.*

# Backup files
*.bak
*.backup
*.old