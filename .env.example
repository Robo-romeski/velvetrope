# VelvetKey local environment
# Copy to `.env` in the repo root for Docker Compose, and to `backend/.env` /
# `frontend/.env.local` for local `npm run` development.

NODE_ENV=development

# Backend (Nest) — default 3010 to match docker-compose.yml
PORT=3010
AUTH_SECRET=dev-auth-secret-change-me-32-chars!!
DATABASE_PATH=data/dev.sqlite
# DATABASE_URL=postgres://velvet:velvet@localhost:5432/velvetkey
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend / CORS (backend uses APP_BASE_URL or CORS_ORIGINS in production)
APP_BASE_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
