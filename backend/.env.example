# Backend environment variables
NODE_ENV=development
PORT=3010
AUTH_SECRET=dev-auth-secret-change-me-32-chars!!
# Dev only: return reset token in forgot-password JSON (never enable in production)
# EXPOSE_PASSWORD_RESET_TOKEN=true

# Email (Resend). Without RESEND_API_KEY, outbound mail is logged/captured only.
# RESEND_API_KEY=
# EMAIL_FROM=VelvetKey <noreply@yourdomain.com>

# Trust & safety — email when a user files a report (optional)
# TRUST_REPORT_NOTIFY_EMAIL=trust@yourdomain.com

# Private check-in photo storage (S3 or compatible provider)
# S3_PHOTO_BUCKET=velvetkey-private
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Persona identity verification
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=itmpl_...
# PERSONA_ENVIRONMENT_ID=env_...
# PERSONA_WEBHOOK_SECRET=

# Production CORS (comma-separated). Defaults to APP_BASE_URL in production, localhost:3000 in dev.
# CORS_ORIGINS=http://localhost:3000
# APP_BASE_URL=http://localhost:3000

# Database (use one approach)
# SQLite file (default local dev): migrations run on startup; delete the file if schema drifted from old synchronize mode
DATABASE_PATH=data/dev.sqlite
# Postgres (production / docker --profile postgres): migrations run on startup
# DATABASE_URL=postgres://velvet:velvet@localhost:5432/velvetkey

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
