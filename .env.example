# VelvetKey local environment
# Copy to `.env` in the repo root for Docker Compose, and to `backend/.env` /
# `frontend/.env.local` for local `npm run` development.

NODE_ENV=development

# Backend (Nest) — default 3010 to match docker-compose.yml
PORT=3010
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=YOUR_API_AUDIENCE
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
DATABASE_PATH=data/dev.sqlite
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Frontend (Next.js Auth0 SDK v4)
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_SECRET=generate-a-32-plus-character-secret
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH0_AUDIENCE=YOUR_API_AUDIENCE
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010
