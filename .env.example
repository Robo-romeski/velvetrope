# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Application ports
BACKEND_PORT=3010
FRONTEND_PORT=3000

# Backend URL (used by frontend to make API calls)
NEXT_PUBLIC_API_URL=http://localhost:3010

# Frontend URL (used for CORS configuration)
FRONTEND_URL=http://localhost:3000

# ============================================================================
# AUTH0 CONFIGURATION
# ============================================================================

# Backend JWT Verification
# Get this from your Auth0 Application Settings
# Format: https://YOUR_DOMAIN.auth0.com/
AUTH0_ISSUER=https://your-tenant.auth0.com/

# Auth0 Audience (API Identifier)
# This should match the identifier of your Auth0 API
AUTH0_AUDIENCE=https://api.velvetkey.example.com

# Frontend Auth0 Configuration
# Get these from your Auth0 Application Settings (Regular Web Application)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Auth0 Secret for session encryption
# Generate a secure random string (32+ characters)
# Example: openssl rand -base64 32
AUTH0_SECRET=your_very_long_random_secret_at_least_32_characters_long

# Auth0 Base URL (where your app is hosted)
AUTH0_BASE_URL=http://localhost:3000

# Auth0 Callback URLs (must match Auth0 Application Settings)
AUTH0_CALLBACK_URL=http://localhost:3000/api/auth/callback
AUTH0_LOGOUT_URL=http://localhost:3000

# ============================================================================
# STRIPE CONFIGURATION
# ============================================================================

# Stripe Secret Key
# Get this from https://dashboard.stripe.com/apikeys
# Use test key (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Connect Configuration
# URLs for Stripe Connect onboarding flow
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/host/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/host/stripe/refresh

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type (sqlite for development, postgres for production)
DB_TYPE=sqlite

# SQLite Configuration (Development)
# Path to SQLite database file
DB_DATABASE=./velvetkey.db

# PostgreSQL Configuration (Production)
# Uncomment and configure these when using PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=velvetkey
# DB_PASSWORD=your_secure_password
# DB_DATABASE=velvetkey
# DB_SSL=false

# Database synchronization (set to false in production)
# When true, TypeORM will auto-create/update tables based on entities
DB_SYNCHRONIZE=true

# Database logging (set to false in production for performance)
DB_LOGGING=true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# Rate limiting (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Stripe Connect features
ENABLE_STRIPE_CONNECT=true

# Enable invite code system
ENABLE_INVITE_CODES=true

# Enable check-in system
ENABLE_CHECKIN=true

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Enable API documentation (Swagger)
ENABLE_API_DOCS=true

# API documentation path
API_DOCS_PATH=api/docs

# Enable debug mode (additional logging, error details)
DEBUG_MODE=true

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test database (in-memory SQLite for tests)
TEST_DB_TYPE=sqlite
TEST_DB_DATABASE=:memory:

# Mock Auth0 for testing
TEST_AUTH0_ISSUER=https://test.auth0.com/
TEST_AUTH0_AUDIENCE=https://api.test.example.com

# ============================================================================
# PRODUCTION CONSIDERATIONS
# ============================================================================

# When deploying to production, ensure you:
# 1. Set NODE_ENV=production
# 2. Use production Auth0 tenant and credentials
# 3. Use production Stripe keys (sk_live_...)
# 4. Configure PostgreSQL database
# 5. Set DB_SYNCHRONIZE=false (use migrations instead)
# 6. Set DB_LOGGING=false for performance
# 7. Generate a new, secure AUTH0_SECRET
# 8. Update all URLs to production domains
# 9. Configure proper CORS_ORIGINS
# 10. Set DEBUG_MODE=false
# 11. Review and adjust rate limiting settings
# 12. Enable SSL/TLS for database connections
# 13. Configure proper logging and monitoring
# 14. Set up proper backup strategies for database

# ============================================================================
# DOCKER COMPOSE OVERRIDES
# ============================================================================

# When using Docker Compose, some values may be overridden:
# - BACKEND_PORT: Exposed on host as 3010
# - FRONTEND_PORT: Exposed on host as 3000
# - DB_HOST: Set to 'db' service name (if using PostgreSQL container)
# - NEXT_PUBLIC_API_URL: Should point to http://localhost:3010

# ============================================================================
# QUICK START CHECKLIST
# ============================================================================

# [ ] Copy this file to .env
# [ ] Create Auth0 Application (Regular Web Application)
# [ ] Create Auth0 API
# [ ] Update AUTH0_ISSUER, AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET
# [ ] Generate AUTH0_SECRET: openssl rand -base64 32
# [ ] Get Stripe test keys from dashboard
# [ ] Update STRIPE_SECRET_KEY
# [ ] Create Stripe webhook endpoint and update STRIPE_WEBHOOK_SECRET
# [ ] Verify all URLs match your local setup
# [ ] Run: docker-compose up --build
# [ ] Test: http://localhost:3000 (frontend)
# [ ] Test: http://localhost:3010/healthz (backend health check)
# [ ] Test: http://localhost:3010/api/docs (API documentation)

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# CORS Errors:
# - Verify FRONTEND_URL matches your frontend origin
# - Check CORS_ORIGINS includes your frontend URL
# - Ensure NEXT_PUBLIC_API_URL points to correct backend

# Auth0 Errors:
# - Verify AUTH0_ISSUER ends with trailing slash
# - Check AUTH0_AUDIENCE matches your API identifier
# - Ensure callback URLs are configured in Auth0 dashboard
# - Verify AUTH0_SECRET is at least 32 characters

# Stripe Errors:
# - Use test keys (sk_test_...) for development
# - Verify webhook secret matches Stripe dashboard
# - Check return/refresh URLs are accessible

# Database Errors:
# - Ensure DB_DATABASE path is writable (SQLite)
# - Verify PostgreSQL connection details (production)
# - Check DB_SYNCHRONIZE is true for development

# Port Conflicts:
# - Ensure ports 3000 and 3010 are not in use
# - Check docker-compose.yml port mappings
# - Verify firewall allows local connections